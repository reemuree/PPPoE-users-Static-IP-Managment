# Copy to .env and edit. Never commit .env.

# --- MikroTik router (use a READ-ONLY API user; see README) ---
ROUTER_HOST=192.168.54.1
ROUTER_PORT=7840
ROUTER_USER=test
ROUTER_PASSWORD=112233
ROUTER_TIMEOUT=10
# Use the api-ssl service (default port 8729) instead of plain API
ROUTER_USE_SSL=false
# Verify the router's TLS certificate (RouterOS certificates are usually self-signed)
ROUTER_SSL_VERIFY=false

# --- Web app ---
HOST=127.0.0.1
PORT=5000
# Set true when served over HTTPS (marks the session cookie Secure)
SESSION_COOKIE_SECURE=false
# Set true only when nginx (or another single reverse proxy) is in front of the app
BEHIND_PROXY=false
# Optional. If empty, a random key is generated and saved to instance/secret_key
SECRET_KEY=

# First-run admin account. Used only while no admin exists in the database;
# after the first start you can delete ADMIN_PASSWORD from this file.
# (Or run: python app.py create-admin)
ADMIN_USER=admin
ADMIN_PASSWORD=

# SQLite file for settings and admin account (keep outside any public directory)
DATABASE_PATH=instance/app.db

# --- Behaviour ---
# Default cap on monitored addresses (changeable in Settings). Protects memory.
MAX_ADDRESSES=65536
# Router data younger than this many seconds is served from cache
CACHE_TTL=15
